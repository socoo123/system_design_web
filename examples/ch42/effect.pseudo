reject missing, empty or noncanonical scope/event/account as PERMANENT_SCHEMA_ERROR
BEGIN IMMEDIATE                       // one SQLite write transaction
claimed = SQL("""
  INSERT INTO inbox(scope, event_id, digest, result)
  VALUES (:scope, :event, :digest, 'APPLIED')
  ON CONFLICT(scope, event_id) DO NOTHING
  RETURNING event_id
""")
if claimed has one row:
    SQL("INSERT INTO ledger VALUES (:scope, :event, :account, :delta)")
    changed = SQL("""
      UPDATE account SET balance = balance + :delta
      WHERE account_id = :account
    """).rowCount
    if changed != 1: ROLLBACK; fail MISSING_ACCOUNT
    COMMIT                            // inbox + ledger + balance + result
    return APPLIED
else:
    saved = SQL("""
      SELECT digest, result FROM inbox
      WHERE scope = :scope AND event_id = :event
    """).oneRow
    if saved.digest != digest: ROLLBACK; fail IDENTITY_CONFLICT
    COMMIT
    return saved.result               // no second delta
// Any SQL error: ROLLBACK; do not advance the source position.
// A lost COMMIT reply is UNKNOWN: replay the same identity.
