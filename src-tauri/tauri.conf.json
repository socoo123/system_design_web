{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SystemDesignWeb",
  "version": "0.1.0",
  "identifier": "com.zy.systemdesignweb",
  "build": {
    "beforeDevCommand": "npm --prefix ../legacy run dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "npm --prefix ../legacy run build",
    "frontendDist": "../legacy/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "系统设计面试 · 由浅入深",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#e9e2d4"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
